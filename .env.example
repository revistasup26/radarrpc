# Copia este archivo a .env y rellena los valores. Docker Compose lo lee automáticamente.
# NUNCA subas .env al repositorio.

# Cosecha (polite pool de Crossref/OpenAlex)
RADAR_MAILTO=rpc@up.edu.mx

# LLM en la nube para el diálogo socrático (Groq u otro OpenAI-compatible)
RADAR_LLM_URL=https://api.groq.com/openai/v1
RADAR_LLM_MODEL=llama-3.3-70b-versatile
RADAR_LLM_API_KEY=

# Redalyc (opcional)
REDALYC_TOKEN=
